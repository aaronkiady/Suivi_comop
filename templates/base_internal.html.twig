{% extends 'base.html.twig' %}

{% block body_class %}oti-body{% endblock %}

{% block body %}
<div class="d-flex" id="wrapper">

    {# ========================================
       SIDEBAR
       ======================================== #}
    <aside id="sidebar-wrapper">
        <div class="sidebar-brand">
            <img src="{{ asset('images/Logo_OTI.png') }}" alt="OTI Groupe">
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-label">Menu</div>
            <a href="{{ path('app_comop_index') }}"
               class="sidebar-link {% if app.request.attributes.get('_route') starts with 'app_comop' %}active{% endif %}">
                <i class="bi bi-receipt-cutoff"></i>
                <span>Comops</span>
            </a>
            {% if is_granted('ROLE_COMPTA') or is_granted('ROLE_ADMIN') %}
            <div class="sidebar-label">Finance</div>
            <a href="{{ path('app_paiement_dispo_index') }}"
               class="sidebar-link {% if app.request.attributes.get('_route') starts with 'app_paiement_dispo' %}active{% endif %}">
                <i class="bi bi-cash"></i>
                <span>Paiement disponible</span>
            </a>
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
                <div class="sidebar-label mt-4">Administration</div>
                <a href="{{ path('app_admin_user_index') }}"
                   class="sidebar-link {% if app.request.attributes.get('_route') starts with 'app_admin_user' %}active{% endif %}">
                    <i class="bi bi-people"></i>
                    <span>Utilisateurs</span>
                </a>
            {% endif %}
        </nav>

        {% if app.user %}
        <div class="sidebar-footer">
            <div class="user-chip">
                <div class="avatar">{{ (app.user.nom|default(' '))|first|upper }}{{ (app.user.prenoms|default(' '))|first|upper }}</div>
                <div class="min-w-0">
                    <div class="user-chip-name text-truncate">{{ app.user.nom }} {{ app.user.prenoms }}</div>
                    <div class="user-chip-mail text-truncate">{{ app.user.email|default('') }}</div>
                </div>
            </div>
        </div>
        {% endif %}
    </aside>
    <div id="sidebar-backdrop"></div>

    {# ========================================
       CONTENU PRINCIPAL
       ======================================== #}
    <div id="page-content-wrapper">

        <nav class="topbar">
            <button class="btn btn-link text-dark px-0 me-3 d-lg-none" id="menu-toggle" aria-label="Menu">
                <i class="bi bi-list fs-3"></i>
            </button>

            <div class="topbar-welcome d-none d-sm-flex">
                <i class="bi bi-stars"></i>
                <span>Bienvenue sur votre espace de gestion</span>
            </div>

            <div class="ms-auto">
                {% if app.user %}
                    <div class="dropdown">
                        <a href="#" class="topbar-user dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar avatar-sm">{{ (app.user.nom|default(' '))|first|upper }}{{ (app.user.prenoms|default(' '))|first|upper }}</span>
                            <span class="d-none d-md-inline">{{ app.user.nom }} {{ app.user.prenoms }}</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item small" href="{{ path('app_profile') }}"><i class="bi bi-person me-2"></i> Mon profil</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item small text-danger" href="{{ logout_path() }}"><i class="bi bi-box-arrow-right me-2"></i> Déconnexion</a></li>
                        </ul>
                    </div>
                {% endif %}
            </div>
        </nav>

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show shadow-sm border-0" role="alert">
                    <i class="bi bi-{{ type == 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill' }} me-2"></i>
                    {{ message|raw }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <main class="container-fluid p-3 p-md-4">
            {% block page_header %}{% endblock %}

            {% for type, messages in app.flashes %}
                {% set alert_type = {success: 'success', warning: 'warning', info: 'info'}[type] ?? 'danger' %}
                {% for message in messages %}
                    <div class="alert alert-{{ alert_type }} alert-dismissible fade show oti-alert" role="alert">
                        <i class="bi bi-{{ alert_type == 'success' ? 'check-circle-fill' : (alert_type == 'info' ? 'info-circle-fill' : 'exclamation-triangle-fill') }} me-2"></i>
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block content %}{% endblock %}
        </main>
    </div>
</div>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --oti-blue: #1f5085;
        --oti-blue-dark: #163a63;
        --oti-blue-soft: rgba(31, 80, 133, 0.08);
        --oti-orange: #f58220;
        --oti-orange-soft: rgba(245, 130, 32, 0.12);
        --oti-border: #e6eaf0;
        --oti-bg: #f4f6fa;
        --oti-radius: 14px;
        --sidebar-w: 264px;
    }

    body.oti-body, body { background-color: var(--oti-bg) !important; font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    .min-w-0 { min-width: 0; }

    /* ---------- Sidebar ---------- */
    #sidebar-wrapper {
        width: var(--sidebar-w);
        min-width: var(--sidebar-w);
        background: #fff;
        border-right: 1px solid var(--oti-border);
        display: flex;
        flex-direction: column;
        position: sticky;
        top: 0;
        height: 100vh;
    }
    .sidebar-brand {
        padding: 1.5rem 1.5rem 1.25rem;
        text-align: center;
        border-bottom: 1px solid var(--oti-border);
        position: relative;
    }
    .sidebar-brand::after {
        content: '';
        position: absolute;
        left: 50%; bottom: -1px;
        width: 56px; height: 3px;
        transform: translateX(-50%);
        background: linear-gradient(90deg, var(--oti-blue), var(--oti-orange));
        border-radius: 3px;
    }
    .sidebar-brand img { height: 54px; width: auto; }
    .sidebar-nav { padding: 1.25rem 1rem; flex: 1; overflow-y: auto; }
    .sidebar-label {
        font-size: .68rem; font-weight: 700; letter-spacing: 1.2px;
        text-transform: uppercase; color: #9aa5b4;
        padding: 0 .75rem; margin-bottom: .5rem;
    }
    .sidebar-link {
        display: flex; align-items: center; gap: .75rem;
        padding: .65rem .9rem; margin-bottom: .25rem;
        border-radius: 10px; color: #4b5767;
        font-weight: 500; font-size: .92rem; text-decoration: none;
        position: relative; transition: all .2s ease;
    }
    .sidebar-link i { font-size: 1.1rem; }
    .sidebar-link:hover { background: var(--oti-blue-soft); color: var(--oti-blue); }
    .sidebar-link.active {
        background: linear-gradient(90deg, var(--oti-blue-soft), transparent);
        color: var(--oti-blue); font-weight: 600;
    }
    .sidebar-link.active::before {
        content: ''; position: absolute; left: -1rem; top: 20%; bottom: 20%;
        width: 4px; border-radius: 0 4px 4px 0; background: var(--oti-orange);
    }
    .sidebar-footer { padding: 1rem; border-top: 1px solid var(--oti-border); }
    .user-chip { display: flex; align-items: center; gap: .75rem; padding: .6rem; border-radius: 12px; background: var(--oti-bg); }
    .user-chip-name { font-weight: 600; font-size: .85rem; color: #1f2937; }
    .user-chip-mail { font-size: .72rem; color: #8895a7; }

    .avatar {
        width: 38px; height: 38px; border-radius: 50%;
        background: linear-gradient(135deg, var(--oti-blue), var(--oti-blue-dark));
        color: #fff; font-weight: 700; font-size: .8rem;
        display: inline-flex; align-items: center; justify-content: center;
        flex-shrink: 0; letter-spacing: .5px;
    }
    .avatar-sm { width: 34px; height: 34px; font-size: .75rem; }

    /* ---------- Topbar ---------- */
    #page-content-wrapper { flex: 1; min-width: 0; }
    .topbar {
        display: flex; align-items: center;
        background: rgba(255,255,255,.85); backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--oti-border);
        padding: .75rem 1.5rem; position: sticky; top: 0; z-index: 1020;
    }
    .topbar-welcome { align-items: center; gap: .5rem; color: #6b778a; font-size: .85rem; }
    .topbar-welcome i { color: var(--oti-orange); }
    .topbar-user {
        display: flex; align-items: center; gap: .6rem;
        color: #1f2937; text-decoration: none; font-weight: 600; font-size: .88rem;
        padding: .25rem .5rem .25rem .25rem; border-radius: 999px; transition: background .2s;
    }
    .topbar-user:hover { background: var(--oti-blue-soft); }

    /* ---------- En-tête de page ---------- */
    .page-header {
        display: flex; flex-wrap: wrap; gap: 1rem;
        justify-content: space-between; align-items: center;
        margin-bottom: 1.5rem;
    }
    .page-title { font-size: 1.5rem; font-weight: 700; color: var(--oti-blue); margin: 0; letter-spacing: -.3px; }
    .page-subtitle { color: #7b8798; font-size: .87rem; margin: .15rem 0 0; }
    .btn-back {
        width: 38px; height: 38px; border-radius: 10px;
        display: inline-flex; align-items: center; justify-content: center;
        background: #fff; border: 1px solid var(--oti-border); color: var(--oti-blue);
        transition: all .2s; text-decoration: none;
    }
    .btn-back:hover { background: var(--oti-blue); color: #fff; border-color: var(--oti-blue); }

    /* ---------- Cartes ---------- */
    .card {
        border: 1px solid var(--oti-border);
        box-shadow: 0 2px 12px rgba(22, 58, 99, .04);
        border-radius: var(--oti-radius);
        overflow: hidden; background: #fff;
    }
    .card-header {
        background: #fff; border-bottom: 1px solid var(--oti-border);
        font-weight: 600; color: var(--oti-blue); padding: 1.1rem 1.5rem;
    }

    .stat-card {
        position: relative; padding: 1.15rem 1.25rem; height: 100%;
        display: flex; align-items: center; gap: 1rem;
    }
    .stat-icon {
        width: 46px; height: 46px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; flex-shrink: 0;
    }
    .stat-icon.blue   { background: var(--oti-blue-soft); color: var(--oti-blue); }
    .stat-icon.orange { background: var(--oti-orange-soft); color: var(--oti-orange); }
    .stat-icon.green  { background: rgba(25,135,84,.12); color: #198754; }
    .stat-icon.amber  { background: rgba(255,193,7,.18); color: #b58100; }
    .stat-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .8px; color: #8895a7; font-weight: 600; }
    .stat-value { font-size: 1.35rem; font-weight: 700; color: #1f2937; line-height: 1.2; }

    /* ---------- Tableaux ---------- */
    .table thead th {
        background: #f8fafc; color: #7b8798; font-weight: 600;
        border-bottom: 1px solid var(--oti-border);
        font-size: .72rem; text-transform: uppercase; letter-spacing: .6px;
        padding: .9rem 1rem; white-space: nowrap;
    }
    .table tbody td { padding: .95rem 1rem; vertical-align: middle; border-color: #f0f3f7; }
    .table tbody tr { transition: background-color .15s ease; }
    .table-hover tbody tr:hover { background-color: rgba(245, 130, 32, .04); }

    .table-toolbar {
        display: flex; flex-wrap: wrap; gap: .75rem; align-items: center;
        justify-content: space-between; padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--oti-border);
    }
    .search-box { position: relative; min-width: 260px; }
    .search-box i { position: absolute; left: .85rem; top: 50%; transform: translateY(-50%); color: #9aa5b4; }
    .search-box input { padding-left: 2.4rem; border-radius: 10px; background: #f8fafc; }

    .empty-state { padding: 3.5rem 1rem; text-align: center; color: #8895a7; }
    .empty-state i { font-size: 2.5rem; opacity: .5; display: block; margin-bottom: .5rem; }

    .action-btn {
        width: 34px; height: 34px; border-radius: 9px; border: 1px solid var(--oti-border);
        background: #fff; display: inline-flex; align-items: center; justify-content: center;
        transition: all .15s; text-decoration: none;
    }
    .action-btn:hover { background: var(--oti-blue-soft); border-color: var(--oti-blue); transform: translateY(-1px); }
    .action-btn.edit:hover { background: var(--oti-orange-soft); border-color: var(--oti-orange); }

    /* ---------- Badges ---------- */
    .badge-soft {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .35rem .75rem; border-radius: 999px;
        font-size: .75rem; font-weight: 600; border: 1px solid transparent;
    }
    .badge-soft::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .badge-soft.success   { background: rgba(25,135,84,.1);  color: #157347; border-color: rgba(25,135,84,.2); }
    .badge-soft.warning   { background: rgba(245,130,32,.12); color: #c8650a; border-color: rgba(245,130,32,.25); }
    .badge-soft.secondary { background: rgba(108,117,125,.1); color: #5c636a; border-color: rgba(108,117,125,.2); }
    .badge-soft.danger    { background: rgba(220,53,69,.1);  color: #b02a37; border-color: rgba(220,53,69,.2); }
    .badge-soft.primary   { background: var(--oti-blue-soft); color: var(--oti-blue); border-color: rgba(31,80,133,.2); }

    /* ---------- Boutons ---------- */
    .btn-oti {
        background: linear-gradient(135deg, var(--oti-blue), var(--oti-blue-dark));
        color: #fff; border-radius: 10px; padding: .55rem 1.25rem;
        font-weight: 600; font-size: .9rem; border: none;
        transition: all .25s ease; display: inline-flex; align-items: center;
        justify-content: center; text-decoration: none; box-shadow: 0 4px 12px rgba(31,80,133,.2);
    }
    .btn-oti:hover, .btn-oti:focus {
        background: linear-gradient(135deg, var(--oti-orange), #e06f0d);
        color: #fff; transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(245,130,32,.3);
    }
    .btn-outline-oti {
        color: var(--oti-blue); border: 1px solid var(--oti-border);
        border-radius: 10px; padding: .55rem 1.25rem; font-weight: 500; font-size: .9rem;
        transition: all .2s; background: #fff; display: inline-flex; align-items: center; text-decoration: none;
    }
    .btn-outline-oti:hover { background: #fff; border-color: var(--oti-orange); color: var(--oti-orange); }
    .btn-sm { padding: .4rem .85rem; font-size: .85rem; border-radius: 8px; }

    /* ---------- Formulaires ---------- */
    .form-section-title {
        display: flex; align-items: center; gap: .6rem;
        font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
        color: var(--oti-blue); margin-bottom: 1rem; padding-bottom: .6rem;
        border-bottom: 1px dashed var(--oti-border);
    }
    .form-section-title i {
        width: 28px; height: 28px; border-radius: 8px; background: var(--oti-orange-soft);
        color: var(--oti-orange); display: inline-flex; align-items: center; justify-content: center;
    }
    .form-label { font-size: .84rem; font-weight: 600; color: #4b5563; margin-bottom: .35rem; }
    .form-control, .form-select {
        padding: .6rem .85rem; font-size: .92rem; border-radius: 10px; border-color: #dde3ec;
    }
    .form-control:focus, .form-select:focus {
        border-color: var(--oti-orange); box-shadow: 0 0 0 .22rem rgba(245,130,32,.15);
    }
    .input-group-text { background: var(--oti-blue-soft); color: var(--oti-blue); font-weight: 600; font-size: .82rem; border-color: #dde3ec; border-radius: 0 10px 10px 0; }
    .input-group > .form-control:not(:last-child) { border-radius: 10px 0 0 10px; }
    .form-text { font-size: .78rem; }
    .invalid-feedback, .form-error-message { font-size: .8rem; }

    .oti-alert { border: 0; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,.05); }
    h4 { font-size: 1.25rem; }

    /* ---------- Responsive ---------- */
    #sidebar-backdrop { display: none; }
    @media (max-width: 991.98px) {
        #sidebar-wrapper {
            position: fixed; left: calc(var(--sidebar-w) * -1); top: 0; z-index: 1045;
            transition: left .3s ease; box-shadow: 0 0 40px rgba(0,0,0,.15);
        }
        #sidebar-wrapper.toggled { left: 0; }
        #sidebar-backdrop.show { display: block; position: fixed; inset: 0; background: rgba(15,23,42,.4); z-index: 1040; }
        .topbar { padding: .75rem 1rem; }
        .search-box { min-width: 100%; }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.getElementById('menu-toggle');
        const sidebar = document.getElementById('sidebar-wrapper');
        const backdrop = document.getElementById('sidebar-backdrop');
        const flip = () => { sidebar.classList.toggle('toggled'); backdrop.classList.toggle('show'); };

        if (toggle) toggle.addEventListener('click', (e) => { e.preventDefault(); flip(); });
        if (backdrop) backdrop.addEventListener('click', flip);
    });
</script>
{% endblock %}
