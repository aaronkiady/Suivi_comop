{% extends 'base_internal.html.twig' %}

{% block title %}Mon Profil | OTI{% endblock %}

{% block page_header %}
<div class="mb-3">
    <h4 class="mb-0 fw-bold" style="color: var(--oti-blue);">Mon Profil</h4>
    <p class="text-muted small mb-0">Gérez vos informations personnelles et votre sécurité</p>
</div>
{% endblock %}

{% block content %}
<div class="row g-3">

    {# --- Carte Identité --- #}
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body text-center py-4">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                     style="width: 80px; height: 80px;">
                    <i class="bi bi-person-fill fs-1"></i>
                </div>
                <h5 class="fw-bold mb-1">{{ app.user.nom }} {{ app.user.prenoms }}</h5>
                <p class="text-muted small mb-2">{{ app.user.email }}</p>
                <span class="badge bg-light text-dark border mb-3">
                    <i class="bi bi-hash me-1"></i>{{ app.user.matricule }}
                </span>

                <hr class="my-3 opacity-25">

                <div class="text-start small">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Rôle</span>
                        <strong class="text-end">
                            {% for role in app.user.roles %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">Admin</span>
                                {% elseif role == 'ROLE_DT' %}
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">DT</span>
                                {% elseif role == 'ROLE_COMPTA' %}
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Compta</span>
                                {% elseif role == 'ROLE_USER' %}
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">User</span>
                                {% endif %}
                            {% endfor %}
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# --- Formulaires --- #}
    <div class="col-lg-8">

        {# Formulaire infos #}
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-person-gear me-2" style="color: var(--oti-orange);"></i> Informations personnelles
            </div>
            <div class="card-body p-4">
                {{ form_start(profileForm) }}
                    <div class="row g-3">
                        <div class="col-md-6">{{ form_row(profileForm.nom) }}</div>
                        <div class="col-md-6">{{ form_row(profileForm.prenoms) }}</div>
                        <div class="col-md-6">{{ form_row(profileForm.matricule) }}</div>
                        <div class="col-md-6">{{ form_row(profileForm.email) }}</div>
                    </div>
                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button class="btn btn-primary btn-sm px-3" style="background-color: var(--oti-blue); border-color: var(--oti-blue);">
                            <i class="bi bi-check-lg me-1"></i> Enregistrer
                        </button>
                    </div>
                {{ form_end(profileForm) }}
            </div>
        </div>

        {# Formulaire mot de passe #}
        <div class="card">
            <div class="card-header">
                <i class="bi bi-shield-lock me-2" style="color: var(--oti-orange);"></i> Changer le mot de passe
            </div>
            <div class="card-body p-4">
                {{ form_start(passwordForm) }}
                    <div class="row g-3">
                        <div class="col-12">{{ form_row(passwordForm.oldPassword) }}</div>
                        <div class="col-md-6">{{ form_row(passwordForm.newPassword.first) }}</div>
                        <div class="col-md-6">{{ form_row(passwordForm.newPassword.second) }}</div>
                    </div>
                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button class="btn btn-warning btn-sm px-3 text-white" style="background-color: var(--oti-orange); border-color: var(--oti-orange);">
                            <i class="bi bi-key me-1"></i> Modifier le mot de passe
                        </button>
                    </div>
                {{ form_end(passwordForm) }}
            </div>
        </div>

    </div>
</div>
{% endblock %}