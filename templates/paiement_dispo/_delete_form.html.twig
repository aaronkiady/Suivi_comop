<form method="post" action="{{ path('app_paiement_dispo_delete', {'id': paiement_dispo.id}) }}" 
      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce paiement ? Cette action est irréversible.');" 
      class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ paiement_dispo.id) }}">
    <button class="btn btn-outline-danger btn-sm px-3">
        <i class="bi bi-trash me-1"></i> Supprimer
    </button>
</form>