{% extends 'base_internal.html.twig' %}

{% block title %}Nouvel Utilisateur | OTI{% endblock %}

{% block page_header %}
<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <a href="{{ path('app_admin_user_index') }}" class="btn-back" title="Retour à la liste">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 class="page-title">Créer un Utilisateur</h1>
            <p class="page-subtitle">Attribuez un rôle et des accès</p>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="card">
    <div class="card-body p-4">
        {{ form_start(form) }}

            <div class="form-section-title"><i class="bi bi-person"></i> Identité</div>
            <div class="row g-3 mb-4">
                <div class="col-md-6">{{ form_row(form.nom) }}</div>
                <div class="col-md-6">{{ form_row(form.prenoms) }}</div>
                <div class="col-md-6">{{ form_row(form.matricule) }}</div>
                <div class="col-md-6">{{ form_row(form.email) }}</div>
            </div>

            <div class="form-section-title"><i class="bi bi-shield-lock"></i> Accès &amp; sécurité</div>
            <div class="row g-3">
                <div class="col-md-6">{{ form_row(form.plainPassword) }}</div>
                <div class="col-md-6">{{ form_row(form.roles) }}</div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a href="{{ path('app_admin_user_index') }}" class="btn-outline-oti">Annuler</a>
                <button type="submit" class="btn-oti">
                    <i class="bi bi-person-plus me-2"></i> Créer l'utilisateur
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
