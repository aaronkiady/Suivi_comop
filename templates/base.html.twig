<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}OTI{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --oti-blue: #1B4F82;
            --oti-blue-dark: #143C64;
            --oti-orange: #F08019;
            --oti-orange-light: #FFA04D;
            --oti-light-bg: #f4f7f6;
            --oti-gray: #6c757d;
            --oti-border: #dee2e6;
        }

        /* ========================================
           STYLE GLOBAL (Toutes les pages)
           ======================================== */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            margin: 0;
        }

        /* ========================================
           STYLE SPÉCIFIQUE UNIQUEMENT POUR LOGIN / REGISTER
           ======================================== */
                body.auth-page {
            background-color: #e3eaf2;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(27, 79, 130, 0.55) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(240, 128, 25, 0.55) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.4) 0%, transparent 50%);
            background-attachment: fixed;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        /* ========================================
           CARTE D'AUTHENTIFICATION
           ======================================== */
        .auth-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(27, 79, 130, 0.12);
            padding: 2.5rem;
            width: 100%;
            max-width: 440px;
            border-top: 5px solid var(--oti-blue);
            animation: fadeInUp 0.5s ease-out;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .auth-logo {
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .auth-logo img {
            max-width: 180px;
            height: auto;
            display: inline-block;
        }

        /* ========================================
           CHAMPS DE FORMULAIRE
           ======================================== */
        .form-control {
            border-radius: 8px;
            padding: 0.75rem 1rem;
            border: 1px solid var(--oti-border);
            transition: border-color 0.2s;
            font-size: 0.95rem;
        }
        .form-control:focus {
            border-color: var(--oti-orange);
            box-shadow: none;
            outline: none;
        }
        .form-label {
            font-weight: 600;
            color: #495057;
            font-size: 0.875rem;
            margin-bottom: 0.4rem;
        }
        .form-check-input:checked {
            background-color: var(--oti-blue);
            border-color: var(--oti-blue);
        }
        .form-check-input:focus {
            border-color: var(--oti-orange);
            box-shadow: none;
        }

        /* ========================================
           INPUT GROUPS
           ======================================== */
        .input-group-text {
            background-color: #ffffff;
            border-radius: 8px 0 0 8px;
            border-right: none;
            border-color: var(--oti-border);
            color: var(--oti-gray);
        }
        .input-group .form-control {
            border-radius: 0 8px 8px 0;
            border-left: none;
        }
        .input-group .form-control.border-start-0 {
            border-left: none;
        }
        .input-group .form-control.border-end-0 {
            border-right: none;
        }
        .input-group:focus-within .input-group-text {
            border-color: var(--oti-orange);
        }
        .input-group .btn-outline-secondary {
            border-radius: 0 8px 8px 0;
            border-left: none;
            border-color: var(--oti-border);
            background-color: #ffffff;
        }
        .input-group .btn-outline-secondary:hover {
            background-color: var(--oti-light-bg);
            border-color: var(--oti-orange);
        }
        .input-group .btn-outline-secondary:focus {
            box-shadow: none;
            border-color: var(--oti-orange);
        }

        /* ========================================
           BOUTON PRINCIPAL
           ======================================== 
        .btn-oti {
            background-color: var(--oti-blue);
            color: white;
            border-radius: 8px;
            padding: 0.75rem;
            font-weight: 600;
            width: 100%;
            border: none;
            font-size: 1rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-oti:hover,
        .btn-oti:focus {
            background-color: var(--oti-orange);
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 6px 15px rgba(240, 128, 25, 0.3);
        }
        .btn-oti:active {
            transform: translateY(0);
        }*/

        /* ========================================
           LIENS
           ======================================== */
        .auth-link {
            color: var(--oti-blue);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }
        .auth-link:hover {
            color: var(--oti-orange);
        }

        /* ========================================
           ALERTES
           ======================================== */
        .alert-danger {
            background-color: #fde8e8;
            border-color: #f5c2c7;
            color: #842029;
            border-radius: 8px;
            font-size: 0.9rem;
        }
        .alert-info {
            background-color: #e7f1ff;
            border-color: #b6d4fe;
            color: var(--oti-blue);
            border-radius: 8px;
            font-size: 0.9rem;
        }

        /* ========================================
           ERREURS DE FORMULAIRE SYMFONY
           ======================================== */
        .form-error-message,
        ul.form-error-message {
            color: #dc3545;
            font-size: 0.85rem;
            margin-top: 0.25rem;
            padding-left: 0;
            list-style: none;
        }

        /* ========================================
           RESPONSIVE
           ======================================== */
        @media (max-width: 576px) {
            .auth-card {
                padding: 1.5rem;
                border-radius: 12px;
            }
            .auth-logo img {
                max-width: 140px;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    {% block body %}{% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    {% block javascripts %}{% endblock %}
</body>
</html>