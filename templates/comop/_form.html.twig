{{ form_start(form) }}

    {# ---------- Commande ---------- #}
    <div class="form-section-title"><i class="bi bi-folder2-open"></i> Commande</div>
    <div class="row g-3 mb-4">
        <div class="col-md-6">{{ form_row(form.projet) }}</div>
        <div class="col-md-6">{{ form_row(form.refBc) }}</div>
        <div class="col-md-6">{{ form_row(form.fournisseur) }}</div>
        <div class="col-md-6">{{ form_row(form.designation) }}</div>
    </div>

    {# ---------- Montants ---------- #}
    <div class="form-section-title"><i class="bi bi-cash-stack"></i> Montants</div>
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            {{ form_label(form.montant) }}
            <div class="input-group">
                {{ form_widget(form.montant) }}
                <span class="input-group-text">MGA</span>
            </div>
            {{ form_errors(form.montant) }}
            {{ form_help(form.montant) }}
        </div>
        <div class="col-md-6">
            {{ form_label(form.montantUsd) }}
            <div class="input-group">
                {{ form_widget(form.montantUsd) }}
                <span class="input-group-text">USD</span>
            </div>
            {{ form_errors(form.montantUsd) }}
            {{ form_help(form.montantUsd) }}
        </div>
    </div>

    {# ---------- Suivi ---------- #}
    <div class="form-section-title"><i class="bi bi-calendar-check"></i> Suivi &amp; paiement</div>
    <div class="row g-3">
    {% if is_granted('ROLE_FINANCE') or is_granted('ROLE_ADMIN') %}
        <div class="col-md-4">{{ form_row(form.statut) }}</div>
    {% endif %}
        <div class="col-md-4">{{ form_row(form.dt) }}</div>
        <div class="col-md-4">{{ form_row(form.datePaiement) }}</div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
        <a href="{{ path('app_comop_index') }}" class="btn-outline-oti">Annuler</a>
        <button type="submit" class="btn-oti">
            <i class="bi bi-check-lg me-2"></i> {{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}
