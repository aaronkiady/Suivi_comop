{{ form_start(form) }}

    {# ---------- Commande ---------- #}
    {% if form.projet is defined %}
        <div class="form-section-title"><i class="bi bi-folder2-open"></i> Commande</div>
        <div class="row g-3 mb-4">
            <div class="col-md-6">{{ form_row(form.projet) }}</div>
            <div class="col-md-6">{{ form_row(form.refBc) }}</div>
            <div class="col-md-6">{{ form_row(form.fournisseur) }}</div>
            <div class="col-md-6">{{ form_row(form.designation) }}</div>
            <div class="col-md-6">{{ form_row(form.dt) }}</div>
        </div>
    {% endif %}

    {# ---------- Montant & Devise ---------- #}
    {% if form.montant is defined or form.devise is defined %}
        <div class="form-section-title"><i class="bi bi-cash-stack"></i> Montant &amp; Devise</div>
        <div class="row g-3 mb-4">
            
            {% if form.devise is defined %}
            <div class="col-md-4">
                {{ form_row(form.devise) }}
            </div>
            {% endif %}
            
            {% if form.montant is defined %}
            <div class="col-md-4">
                {{ form_label(form.montant) }}
                <div class="input-group">
                    {{ form_widget(form.montant) }}
                    <span class="input-group-text devise-label">{{ comop.devise|default('MGA') }}</span>
                </div>
                {{ form_errors(form.montant) }}
            </div>
            {% endif %}

            {# On affiche le reste à payer si on peut voir le montant #}
            {% if form.montant is defined %}
            <div class="col-md-4">
                <label class="form-label">Reste à payer (calculé)</label>
                <input type="text" class="form-control" readonly
                       id="resteAPayer"
                       value="{{ comop.resteAPayer ?? '' }}">
            </div>
            {% endif %}
        </div>
    {% endif %}

    {# ---------- Finances (Payé, Statut, Date) ---------- #}
    {% if form.montantPaye is defined or form.statut is defined %}
        <div class="form-section-title"><i class="bi bi-wallet2"></i> Finances</div>
        <div class="row g-3 mb-4">
            {% if form.montantPaye is defined %}
            <div class="col-md-4">
                {{ form_label(form.montantPaye) }}
                <div class="input-group">
                    {{ form_widget(form.montantPaye) }}
                    <span class="input-group-text">{{ comop.devise|default('MGA') }}</span>
                </div>
                {{ form_errors(form.montantPaye) }}
            </div>
            {% endif %}

            {% if form.statut is defined %}
            <div class="col-md-4">
                {{ form_row(form.statut) }}
            </div>
            {% endif %}

            {% if form.datePaiement is defined %}
            <div class="col-md-4">
                {{ form_row(form.datePaiement) }}
            </div>
            {% endif %}
        </div>
    {% endif %}

    {# ---------- Pièces jointes ---------- #}
    {% if form.piecesJointesFile is defined %}
        <div class="form-section-title"><i class="bi bi-paperclip"></i> Pièces jointes</div>
        <div class="row g-3 mb-4">
            <div class="col-12">
                {{ form_label(form.piecesJointesFile) }}
                {{ form_widget(form.piecesJointesFile) }}
                {{ form_errors(form.piecesJointesFile) }}
            </div>
        </div>
    {% endif %}

    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
        <a href="{{ path('app_comop_index') }}" class="btn-outline-oti">Annuler</a>
        <button type="submit" class="btn-oti">
            <i class="bi bi-check-lg me-2"></i> {{ button_label|default('Enregistrer') }}
        </button>
    </div>

{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', function () {
    const montantEl = document.querySelector('[name$="[montant]"]');
    const payeEl    = document.querySelector('[name$="[montantPaye]"]');
    const deviseEl  = document.querySelector('[name$="[devise]"]');
    const resteEl   = document.getElementById('resteAPayer');

    function updateReste() {
        if (!resteEl) return;
        const m = parseFloat(montantEl?.value || 0);
        const p = parseFloat(payeEl?.value    || 0);
        resteEl.value = Math.max(0, m - p);
    }

    function updateDeviseLabels() {
        if (!deviseEl) return;
        const devise = deviseEl.value || 'MGA';
        document.querySelectorAll('.devise-label').forEach(el => {
            el.textContent = devise;
        });
    }

    montantEl?.addEventListener('input', updateReste);
    payeEl?.addEventListener('input', updateReste);
    deviseEl?.addEventListener('change', function () {
        updateDeviseLabels();
        updateReste();
    });

    updateDeviseLabels();
    updateReste();
});
</script>