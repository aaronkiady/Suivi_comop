{% extends 'base_internal.html.twig' %}

{% block title %}Modifier Comop | OTI{% endblock %}

{% block page_header %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 fw-bold" style="color: var(--oti-blue);">Modifier le Comop</h4>
            <p class="text-muted small mb-0">Mise à jour des informations</p>
        </div>
        <div>
            <a href="{{ path('app_comop_index') }}" class="btn-outline-oti btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Retour à la liste
            </a>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="card p-4">
        {{ include('comop/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
    </div>
{% endblock %}