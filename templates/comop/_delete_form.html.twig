<form method="post" action="{{ path('app_comop_delete', {'id': comop.id}) }}"
      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce Comop ? Cette action est irréversible.');"
      class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comop.id) }}">
    <button type="submit" class="btn btn-outline-danger btn-sm px-3">
        <i class="bi bi-trash me-1"></i> Supprimer
    </button>
</form>
